{
  "name": "gymmap",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gymmap",
      "database_id": "3f42a52c-26cd-4ed6-8ce7-b3b4cf171640"
    }
  ],
  "observability": { "enabled": true }
}
